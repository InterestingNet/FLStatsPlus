<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Authors>SaMo (PvpStats), FLStatsPlus contributors</Authors>
		<Company></Company>
		<Version>0.1.0.0</Version>
		<RootNamespace>PvpStats</RootNamespace>
		<Description>FLStats Plus</Description>
		<Copyright></Copyright>
		<PackageProjectUrl></PackageProjectUrl>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="..\images\background\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</Content>
	</ItemGroup>
	<PropertyGroup>
		<PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
	</PropertyGroup>
	<ItemGroup>
		<EmbeddedResource Include="Export\report_template.html" LogicalName="FLStatsPlus.report_template.html" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="LiteDB" Version="5.0.16" />
	</ItemGroup>
</Project>
